# The submitted configuration, in full.
#
# Every value here is the one used for the numbers in the technical report.
# Paths are resolved from DATA_ROOT so that nothing in this file is specific to
# the machine it was developed on.
#
# DATA_ROOT must contain the official release layout:
#   $DATA_ROOT/dataset/checkpoints/{nav,q,a}_rainbow, loc_rainbow.pth
#   $DATA_ROOT/dataset/features/CLIP-ViT-B-16-views.tsv
#   $DATA_ROOT/dataset/features/clip_vit-h14_mp3d_original.hdf5
#   $DATA_ROOT/dataset/connectivity, $DATA_ROOT/dataset/RAIN_holistic

: "${DATA_ROOT:?set DATA_ROOT to the official dataset root}"
DATASET="$DATA_ROOT/dataset"

# ---- frozen assets, offline ----------------------------------------------
export GTL_SCENE_CACHE_DIR="${GTL_SCENE_CACHE_DIR:-$DATA_ROOT/scene_cache}"
export GTL_SCENE_CACHE_MAX=64
export GTL_PANO_CACHE_MAX=500
export HF_HOME="${HF_HOME:-$DATA_ROOT/hf_cache}"
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:64

# ---- CPU budget ----------------------------------------------------------
# Eight shards share one host.  Without these caps each process spawns several
# hundred threads and the run makes no progress.
export DIALNAV_TORCH_THREADS=4
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4
export VECLIB_MAXIMUM_THREADS=4
export DIALNAV_CPU_CORES_PER_SHARD=20
export DIALNAV_CPU_OFFSET=0

# ---- dialog policy -------------------------------------------------------
export DIALNAV_WTA_MODE=ct_0.6_cap_2   # ask below confidence 0.6, twice at most
export DIALNAV_MAX_ACTION_LEN=400      # navigation steps are not scored

# ---- guide: distinctive referring guidance -------------------------------
export GUIDE_DESC_ENABLED=1
export GUIDE_DESCRIPTION_FILE=          # nothing precomputed; search runs online
export GUIDE_ARRIVAL_CONFIRM=1
export GUIDE_PLAN_ENABLED=0
export GUIDE_CAPTION_SEARCH=1
export GUIDE_CAPTION_TEMPLATE=sentence
export GUIDE_CAPTION_CONTRAST=0.75      # weight on the distractor term
export GUIDE_CAPTION_OBJECTS=4          # one room noun plus four object nouns
export GUIDE_CAPTION_TOPK=16            # views pooled per panorama
export GUIDE_CAPTION_TRUTH_PCT=80       # strictness of the grounding gate
export GUIDE_CAPTION_VERIFY=h14
export GUIDE_H14_FEATURES="$DATASET/features/clip_vit-h14_mp3d_original.hdf5"
export GUIDE_H14_TEXT="${GUIDE_H14_TEXT:-vocab/h14_vocab_text.npz}"

# ---- navigator: retrospective grounding stop -----------------------------
export NAV_RETRO_STOP=1
export NAV_RETRO_MIN_STEP=8
export NAV_RETRO_RESERVE=8
export NAV_RETRO_CLIP=1
export NAV_RETRO_CLIP_TOPK=16
export NAV_RETRO_CLIP_THRESHOLD=0.0
export NAV_RETRO_TOPK=1                 # stop at the single best-scoring node
export CLIP_STOP_ENABLED=1
export CLIP_STOP_APPLY_LOGITS=0
export CLIP_STOP_WEIGHTS="${CLIP_STOP_WEIGHTS:-$DATA_ROOT/cache/ViT-B-16.pt}"
export CLIP_STOP_TOKENIZER="$DATASET/modules/clip_tokenizer/bpe_simple_vocab_16e6.txt.gz"
export CLIP_STOP_FEATURES="$DATASET/features/CLIP-ViT-B-16-views.tsv"
export NAV_SWEEP_ENABLED=1
export NAV_SWEEP_START=8
export NAV_SWEEP_NO_NEW_STEPS=5
export NAV_SWEEP_REPEAT_WINDOW=4
export NAV_SWEEP_MAX_REPEAT_NODES=2
export NAV_SWEEP_MAX_STEPS=0
export NAV_SWEEP_RESERVE=70             # steps held back for the walk to the pick
