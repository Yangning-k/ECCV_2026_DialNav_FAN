# Python 3.10 interpreter with the dependencies in requirements.txt.
DIALNAV_PYTHON=/path/to/python

# Built Matterport3D Simulator directory (containing MatterSim.py and lib).
DIALNAV_MATTERPORT_SIM_BUILD=/path/to/Matterport3DSimulator/build

# Optional: Hugging Face cache for bert-base-uncased.
DIALNAV_HF_HOME=/path/to/huggingface/cache
